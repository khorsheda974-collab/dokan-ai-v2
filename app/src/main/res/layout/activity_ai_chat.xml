<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI diye Customer SS Chinbe" android:textStyle="bold" android:textSize="18sp"/>

        <ImageView android:id="@+id/customerImg" android:layout_width="match_parent" android:layout_height="200dp" android:background="#EEEEEE" android:layout_marginTop="12dp"/>

        <Button android:id="@+id/btnPickCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Customer er SS Pic Select"/>

        <EditText android:id="@+id/etQuery" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Customer ki bolse? Voice hole type korun - ex: ei lal dress ta ache?" android:layout_marginTop="12dp"/>

        <Button android:id="@+id/btnAskAI" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI ke Jiggesh Korun - Stock, Dam Bolbe" android:layout_marginTop="8dp"/>

        <TextView android:id="@+id/txtAIResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI result ekhane asbe..." android:background="#F5F5F5" android:padding="12dp" android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
